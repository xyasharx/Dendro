[Desktop Entry]
Name=Dendro
GenericName=Fedora Package Manager
Comment=DNF5 daemon package manager and RPM dependency inspector
Exec=dendro %f
Icon=io.github.xyasharx.Dendro
Terminal=false
Type=Application
Categories=Settings;PackageManager;
Keywords=fedora;package;dependencies;tree;dnf;rpm;polkit;
MimeType=application/x-rpm;application/x-redhat-package-manager;
StartupNotify=true
