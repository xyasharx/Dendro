<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Dendro Package Manager</vendor>
  <vendor_url>https://github.com/xyasharx/Dendro</vendor_url>
  <icon_name>system-software-install</icon_name>

  <!--
    Package transactions are authorized by dnf5daemon-server's own Polkit
    actions. This is deliberately Dendro's only privileged action. Its fixed
    helper can either delete one validated third-party .repo file or atomically
    create one new, independently validated repository configuration below
    /etc/yum.repos.d. It cannot fetch network data, invoke DNF, invoke a shell,
    overwrite a repository file, or run arbitrary commands.
  -->
  <action id="org.dendro.repo-helper">
    <description>Add or remove a constrained RPM repository configuration file</description>
    <message>Authentication is required to add or remove a repository configuration file</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/dendro-repo-helper</annotate>
  </action>
</policyconfig>