<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
"http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Dendro Package Manager</vendor>
  <vendor_url>https://github.com/xyasharx/Dendro</vendor_url>
  <icon_name>system-software-install</icon_name>

  <!-- Action definition for modern DNF5 (Fedora 41+) -->
  <action id="org.dendro.pkexec.dnf5">
    <description>Manage RPM packages and dependencies via DNF5</description>
    <message>Authentication is required to install or remove software packages</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dnf5</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>

  <!-- Fallback Action definition for legacy DNF4 -->
  <action id="org.dendro.pkexec.dnf">
    <description>Manage RPM packages and dependencies via DNF</description>
    <message>Authentication is required to install or remove software packages</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/dnf</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
